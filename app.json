{
  "expo": {
    "name": "Reported",
    "slug": "reported",
    "privacy": "unlisted",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "jsEngine": "hermes",
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your media to create reports"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-build-properties"
    ],
    "version": "3.1.10",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.reported.reported",
      "buildNumber": "39",
      "appStoreUrl": "https://itunes.apple.com/us/app/reported/id916072964?ls=1",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the devices photos and videos to submit 311 reports with supporting evidence."
      }
    },
    "android": {
      "package": "com.reported1.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/ic_launcher_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDGtEsa9h6bbmepu3hoWzxeNBMlXOOnzUo"
        }
      },
      "icon": "./assets/android/android_icon_round.png",
      "versionCode": 70,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=cab.reported.nyc",
      "permissions": [
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/3249b7b4-8843-4ce9-b47d-1e0365673198"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "3249b7b4-8843-4ce9-b47d-1e0365673198"
      }
    }
  }
}
