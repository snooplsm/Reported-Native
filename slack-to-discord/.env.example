# Slack app credentials
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Discord bot credentials used by npm run sync:channels
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-server-id

# Runtime
PORT=3000
PUBLIC_BASE_URL=https://your-public-domain.example
DATA_DIR=./data

# Slack channel types to provision. Private channels require inviting the bot first.
SLACK_CHANNEL_TYPES=public_channel,private_channel
AUTO_JOIN_PUBLIC_CHANNELS=true

# Discord channel/category behavior
DISCORD_CATEGORY_NAME=Slack Backup
DISCORD_CHANNEL_PREFIX=slack-

# File mirroring
MIRROR_FILES=true
DISCORD_MAX_UPLOAD_MB=8

# Message behavior
INCLUDE_BOT_MESSAGES=true
INCLUDE_MESSAGE_EDITS=true
INCLUDE_MESSAGE_DELETES=true

# Optional historical backfill. Slack Free exposes only currently visible history.
BACKFILL_DAYS=90
BACKFILL_MINUTES=
BACKFILL_CHANNELS=
BACKFILL_PAGE_LIMIT=15
BACKFILL_MAX_PAGES=0
BACKFILL_HISTORY_DELAY_MS=61000
BACKFILL_USE_STATE=true
BACKFILL_DEDUPE=state
BACKFILL_DISCORD_SCAN_LIMIT=100
BACKFILL_LOCK=false
BACKFILL_LOCK_STALE_MINUTES=240
BACKFILL_INCLUDE_THREADS=true

# Optional hourly cleanup for Slack messages deleted after being mirrored.
PRUNE_DAYS=10
PRUNE_CHANNELS=
PRUNE_PAGE_LIMIT=15
PRUNE_MAX_PAGES=0
PRUNE_HISTORY_DELAY_MS=61000
PRUNE_DRY_RUN=false
PRUNE_LOCK=true
PRUNE_LOCK_STALE_MINUTES=240
PRUNE_INCLUDE_THREADS=true
