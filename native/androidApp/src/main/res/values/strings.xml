    <!-- New-report tutorial -->
    <string name="tutorial_report_faster_title">Report faster</string>
    <string name="tutorial_report_faster_body">Reported can fill in plate, time, and address details from your photo or video so you spend less time typing.</string>
    <string name="tutorial_metadata_title">Photo time and location</string>
    <string name="tutorial_metadata_body">Media/location access lets us read image metadata for the location and time of incident. We use it only to prefill your report.</string>
    <string name="tutorial_ai_title">Reported AI + Auto-Report</string>
    <string name="tutorial_ai_body">Reported AI can draft fields from photos. Auto-Report can scan recent photos, group likely blocked bike lane or crosswalk reports, and keeps you in review before submit.</string>
    <string name="tutorial_private_media_title">Private media checks</string>
    <string name="tutorial_scanner_available_body">Reported can scan media you choose or share with the app. Background library scanning is only available in debug builds for testing and is off by default.</string>
    <string name="tutorial_picker_body">Reported uses the privacy-preserving picker and Share sheet. Choose or share a photo when you want us to scan it; we do not keep broad access to your photo library.</string>
